<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TaskEditorActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.MyNotes.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/editor_toolbar_height"
            android:theme="@style/ThemeOverlay.MyNotes.Toolbar"
            app:navigationContentDescription="@string/navigate_up"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:title="@string/new_task" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/editorScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/editorContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/editor_horizontal_padding"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/editor_horizontal_padding"
                android:paddingBottom="@dimen/editor_bottom_padding">

                <EditText
                    android:id="@+id/taskTitleEdt"
                    style="@style/TextAppearance.MyNotes.EditorTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/task_title_hint"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLines="3"
                    android:minHeight="@dimen/editor_title_min_height"
                    android:padding="0dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <TextView
                    android:id="@+id/taskTitleError"
                    style="@style/TextAppearance.MyNotes.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/title_required"
                    android:textColor="@color/danger"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_2"
                    android:layout_marginBottom="@dimen/space_3"
                    android:background="@color/divider"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/taskNotesEdt"
                    style="@style/TextAppearance.MyNotes.EditorBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/task_notes_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="@dimen/task_editor_notes_min_height"
                    android:padding="0dp"
                    android:scrollbars="none"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <TextView
                    android:id="@+id/scheduleLabel"
                    style="@style/TextAppearance.MyNotes.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/task_editor_section_gap"
                    android:layout_marginBottom="@dimen/space_2"
                    android:text="@string/schedule" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.MyNotes.Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/dueDateRow"
                            style="@style/Widget.MyNotes.SettingsRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="@dimen/icon_size"
                                android:layout_height="@dimen/icon_size"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_calendar_today_24"
                                app:tint="@color/text_secondary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_3"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.MyNotes.Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/due_date" />

                                <TextView
                                    android:id="@+id/dueDateValue"
                                    style="@style/TextAppearance.MyNotes.BodySmall"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="@string/add_due_date" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/clearDueBtn"
                                android:layout_width="@dimen/space_12"
                                android:layout_height="@dimen/space_12"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/clear_due_date"
                                android:src="@drawable/ic_close_24"
                                android:visibility="gone"
                                app:tint="@color/text_secondary" />

                            <ImageView
                                android:layout_width="@dimen/icon_size"
                                android:layout_height="@dimen/icon_size"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right_24"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/space_12"
                            android:background="@color/divider"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:id="@+id/dueTimeRow"
                            style="@style/Widget.MyNotes.SettingsRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="@dimen/icon_size"
                                android:layout_height="@dimen/icon_size"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_clock_24"
                                app:tint="@color/text_secondary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_3"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.MyNotes.Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/due_time" />

                                <TextView
                                    android:id="@+id/dueTimeValue"
                                    style="@style/TextAppearance.MyNotes.BodySmall"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="@string/set_date_first" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="@dimen/icon_size"
                                android:layout_height="@dimen/icon_size"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right_24"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/reminderLabel"
                    style="@style/TextAppearance.MyNotes.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/task_editor_section_gap"
                    android:layout_marginBottom="@dimen/space_2"
                    android:text="@string/reminder" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fadingEdgeLength="@dimen/space_4"
                    android:requiresFadingEdge="horizontal"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/reminderChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_1"
                        android:paddingBottom="@dimen/space_1"
                        app:chipSpacingHorizontal="@dimen/space_2"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/reminderChipNone"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/reminder_none" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/reminderChipAtTime"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_at_time" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/reminderChip5"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_5" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/reminderChip15"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_15" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/reminderChip30"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_30" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/reminderChip60"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_1h" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/reminderChip1440"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_1d" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/reminderHint"
                    style="@style/TextAppearance.MyNotes.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:accessibilityLiveRegion="polite"
                    tools:text="No reminder will be sent." />

                <TextView
                    android:id="@+id/reminderError"
                    style="@style/TextAppearance.MyNotes.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/reminder_time_past"
                    android:textColor="@color/danger"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/notificationWarning"
                    style="@style/TextAppearance.MyNotes.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/reminder_permission_warning"
                    android:textColor="@color/danger"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openNotificationSettings"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/space_12"
                    android:text="@string/open_settings"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/exactAlarmWarning"
                    style="@style/TextAppearance.MyNotes.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/exact_alarm_warning"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.MyNotes.Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/task_editor_section_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/settings_row_min_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_4"
                        android:paddingTop="@dimen/space_3"
                        android:paddingEnd="@dimen/space_4"
                        android:paddingBottom="@dimen/space_3">

                        <TextView
                            style="@style/TextAppearance.MyNotes.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mark_as_done" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/doneSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/mark_as_done" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/editorLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_canvas"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="@dimen/progress_size"
            android:layout_height="@dimen/progress_size"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/accent" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
