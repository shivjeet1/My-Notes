<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/note_container"
    style="@style/Widget.MyNotes.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/grid_item_margin"
    android:clickable="true"
    android:focusable="true"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/card_padding"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/space_12"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/titleTxt"
                style="@style/TextAppearance.MyNotes.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_1"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Grocery list" />

            <ImageButton
                android:id="@+id/moreBtn"
                android:layout_width="@dimen/overflow_size"
                android:layout_height="@dimen/overflow_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/note_actions"
                android:padding="@dimen/space_3"
                android:src="@drawable/ic_more_vert_24"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/notesTxt"
            style="@style/TextAppearance.MyNotes.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginEnd="@dimen/space_2"
            android:ellipsize="end"
            android:maxLines="4"
            tools:text="Milk, eggs, coffee, and something for dinner." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/pinned"
                android:layout_width="@dimen/pin_icon_size"
                android:layout_height="@dimen/pin_icon_size"
                android:contentDescription="@string/pinned"
                android:src="@drawable/ic_pin_24"
                android:visibility="gone"
                app:tint="@color/accent" />

            <TextView
                android:id="@+id/dateTxt"
                style="@style/TextAppearance.MyNotes.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="18 Apr 2025" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
